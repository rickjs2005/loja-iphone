# ============================================================================
#  Copie para .env.local e preencha. (na Vercel, cadastre como Environment
#  Variables do projeto de cada loja)
# ============================================================================

# ----------------------------------------------------------------------------
#  SUPABASE (obrigatório) — Project Settings > API no dashboard
# ----------------------------------------------------------------------------
# URL do projeto (ex.: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública anon/publishable. Pode ir para o navegador — é segura por design
# desde que a RLS esteja habilitada (e está, ver supabase/migrations).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ATENÇÃO: este projeto NÃO usa a service_role key. Nunca a coloque aqui.

# URL pública do site (para o preview de link / Open Graph ficar com URL absoluta)
# Ex.: https://loja-do-joao.com.br  (em dev pode deixar vazio)
NEXT_PUBLIC_SITE_URL=

# ----------------------------------------------------------------------------
#  PERSONALIZAÇÃO DA LOJA (white-label) — opcional
#  Se deixar em branco, usa os defaults da loja "iDemo".
#  Troque por loja, sem mexer no código.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_STORE_NAME=
NEXT_PUBLIC_STORE_DESCRIPTION=
# Caminho do logo em /public (ex.: /logo.svg). Troque o arquivo por loja.
NEXT_PUBLIC_STORE_LOGO_URL=
# "1" se o logo for um símbolo/selo (quadrado): o nome da loja aparece em
# texto ao lado dele no cabeçalho. Vazio = logo horizontal que já tem o nome.
NEXT_PUBLIC_STORE_LOGO_BADGE=
# OBRIGATÓRIO em produção: só dígitos, com DDI 55 (ex.: 5511900000000).
# Use o MESMO número da matriz cadastrado no admin (Informações da loja) —
# não existe mais número de demonstração de reserva.
NEXT_PUBLIC_STORE_WHATSAPP=

# Redes sociais (deixe vazio para esconder)
NEXT_PUBLIC_STORE_INSTAGRAM=
NEXT_PUBLIC_STORE_FACEBOOK=
NEXT_PUBLIC_STORE_TIKTOK=

# Paleta (qualquer cor CSS: hex, rgb, hsl)
NEXT_PUBLIC_COLOR_BG=
NEXT_PUBLIC_COLOR_SURFACE=
NEXT_PUBLIC_COLOR_PRIMARY=
NEXT_PUBLIC_COLOR_ACCENT=
NEXT_PUBLIC_COLOR_TEXT=
NEXT_PUBLIC_COLOR_MUTED=
