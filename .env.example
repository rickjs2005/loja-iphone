# ============================================================================
#  Supabase — copie para .env.local e preencha com os dados do seu projeto.
#  (Project Settings > API no dashboard do Supabase)
# ============================================================================

# URL do projeto (ex.: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública anon/publishable. Pode ir para o navegador — é segura por design
# desde que a RLS esteja habilitada (e está, ver supabase/migrations).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================================
#  ATENÇÃO: este projeto NÃO usa a service_role key.
#  Todas as operações do admin usam a sessão autenticada do dono + RLS.
#  Nunca adicione a service_role aqui nem em lugar nenhum do client.
# ============================================================================
